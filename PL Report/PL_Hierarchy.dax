// =====================================================================
// P&L HIERARCHY - CALCULATED COLUMNS ON TBData
// =====================================================================
// Builds the 3 visible columns of the P&L matrix. Each level pulls from a
// different source table depending on which Level 1 section the row is in.
//
//   Level 1  = "OPEX" when TBData[Primary Group] is one of the 12 operating
//              departments; otherwise BellcorpMap[LineItem], reached via
//              TBData -> BellPLMap -> BellcorpMap (on "Row")
//   Level 2  = TBData[Revenue Row Label]            (Revenue)
//              TBData[Cc]                           (COGS)
//              "Bonus" if TBData[Matrix] = 286,     (OPEX)
//              else TBData[Primary Group]
//   Level 3  = TBData[PL Label]                     (Revenue)
//              COGSMap[CTDesc Parent]               (COGS)
//              CCMap[Cost Center]                   (OPEX)
//
// NOTE ON LOOKUPVALUE vs RELATED:
//   Every lookup below is written with LOOKUPVALUE so it works with NO
//   relationships in place. If you already have (or create) a many-to-one
//   relationship from TBData to the map table, swap it for RELATED() --
//   it is materially faster on large trial balances. Both variants are
//   shown for Level 1; the rest follow the same pattern.
//
// >>> Replace the *** KEY *** placeholders with your real join columns. <<<
// =====================================================================


// ---------------------------------------------------------------------
// 1. LEVEL 1  -- Revenue / COGS / OPEX
// ---------------------------------------------------------------------
// OPEX is decided FIRST, by a value test on TBData[Primary Group]. Any row
// whose Primary Group is one of the 12 operating departments below is OPEX,
// regardless of what the BellcorpMap chain says.
//
// This column produces ONLY Revenue / COGS / OPEX. Adjusted EBITDA, Gross
// Profit and Total Revenue cannot appear here -- they are arithmetic across
// sections, not labels on trial-balance rows. See the "ADJUSTED EBITDA AS A
// ROW IN THE MATRIX" section at the end of this file.
//
// Everything that is NOT one of those departments falls through to
// BellcorpMap[LineItem], reached two hops away through a bridge table:
//
//     TBData --many-to-one--> BellPLMap --many-to-one--> BellcorpMap
//                                        (joined on "Row")
//
// RELATED() follows a chain of many-to-one relationships across any number
// of hops, so with both arrows pointing away from TBData it is a one-liner.

PL Level 1 =
VAR _IsOpex =
    TBData[Primary Group]
        IN {
            "BI/Product",
            "Commercial Sales",
            "Construction",
            "Consumer Sales",
            "Corporate Marketing",
            "Direct Field Operations",
            "Direct Legal & Regulatory",
            "G&A",
            "Bonus",
            "Headquarters Expenses",
            "Logistics",
            "Technology"
        }
VAR _LineItem = RELATED ( BellcorpMap[LineItem] )
RETURN
    IF ( _IsOpex, "OPEX", COALESCE ( _LineItem, "Unmapped" ) )


// -- FALLBACK for the BellcorpMap hop: use this when no relationships exist,
//    or when BellPLMap is the "one" side of BOTH relationships (the path from
//    TBData is then many->one then one->many, which RELATED cannot walk).
//    Only the _LineItem VAR changes; the OPEX test is identical.

PL Level 1 =
VAR _IsOpex =
    TBData[Primary Group]
        IN {
            "BI/Product", "Commercial Sales", "Construction", "Consumer Sales",
            "Corporate Marketing", "Direct Field Operations",
            "Direct Legal & Regulatory", "G&A", "Bonus",
            "Headquarters Expenses", "Logistics", "Technology"
        }
VAR _Row =
    LOOKUPVALUE (
        BellPLMap[Row],
        BellPLMap[Account],             // *** KEY *** in BellPLMap
        TBData[Account]                 // *** KEY *** in TBData
    )
VAR _LineItem =
    LOOKUPVALUE (
        BellcorpMap[LineItem],
        BellcorpMap[Row], _Row          // BellcorpMap <-> BellPLMap join on "Row"
    )
RETURN
    IF ( _IsOpex, "OPEX", COALESCE ( _LineItem, "Unmapped" ) )


// -- MAINTAINABLE VARIANT: if the department list changes often, put it in
//    its own table so it is edited in one place instead of inside the DAX.
//    Leave OpexGroups DISCONNECTED -- no relationship to anything.

OpexGroups =
DATATABLE (
    "Primary Group", STRING,
    {
        { "BI/Product" }, { "Commercial Sales" }, { "Construction" },
        { "Consumer Sales" }, { "Corporate Marketing" },
        { "Direct Field Operations" }, { "Direct Legal & Regulatory" },
        { "G&A" }, { "Bonus" }, { "Headquarters Expenses" },
        { "Logistics" }, { "Technology" }
    }
)

// then the test becomes:
//     VAR _IsOpex = TBData[Primary Group] IN ALL ( OpexGroups[Primary Group] )

// Debug tip: text must match EXACTLY, including the "/" in BI/Product and the
// "&" in G&A and Direct Legal & Regulatory. Trailing spaces in the source data
// are the usual culprit when a department silently fails the test -- run
// Trim on the Primary Group column in Power Query before trusting this.
// To find misses, make a temporary column:
//     Debug Opex = TBData[Primary Group] IN { ... }
// and check that every department you expect comes back TRUE.


// ---------------------------------------------------------------------
// 2. LEVEL 2  -- the blue column
//    Revenue -> TBData[Revenue Row Label]
//    COGS    -> TBData[Cc]
//    OPEX    -> "Bonus" when TBData[Matrix] = 286,
//               otherwise TBData[Primary Group]
// ---------------------------------------------------------------------
// The OPEX branch reads Primary Group straight off TBData -- no CCMap lookup
// and no relationship dependency at this level. (CCMap is still needed for
// Level 3.) The Matrix 286 override is tested first, so a bonus row shows
// "Bonus" in place of its department name.

PL Level 2 =
VAR _Section = TBData[PL Level 1]
RETURN
    SWITCH (
        TRUE (),
        _Section = "Revenue", TBData[Revenue Row Label],
        _Section = "COGS",    TBData[Cc],
        _Section = "OPEX",    IF ( TBData[Matrix] = 286, "Bonus", TBData[Primary Group] ),
        BLANK ()
    )

// The two routes to Bonus now agree by construction: a row with
// Primary Group = "Bonus" returns "Bonus" through the ELSE branch, and a row
// with Matrix = 286 returns "Bonus" through the IF. No conflict is possible.
// The override only changes rows whose Primary Group is a DEPARTMENT but
// whose Matrix marks them as bonus -- which is the point of it.

// TYPE NOTE: the test assumes TBData[Matrix] is a NUMBER. If the column is
// Text (Column tools -> Data type), the comparison never matches and no error
// is raised -- every bonus row silently keeps its department name. Quote the
// literal in that case:
//     IF ( TBData[Matrix] = "286", "Bonus", TBData[Primary Group] )

// CONSEQUENCE: Matrix 286 rows from EVERY department collapse into one
// "Bonus" group, so department subtotals EXCLUDE bonus. That is the usual
// intent -- bonus reported as its own P&L line -- but it does mean
// "Direct Field Operations" no longer ties to its fully loaded cost.
//
// If bonus should instead sit UNDER each department, leave Level 2 as plain
// TBData[Primary Group] and put the override in PL Level 3 instead:
//     _Section = "OPEX", IF ( TBData[Matrix] = 286, "Bonus", _CostCenter ),


// ---------------------------------------------------------------------
// 3. LEVEL 3  -- the red column
//    Revenue -> TBData[PL Label]
//    COGS    -> COGSMap[CTDesc Parent]
//    OPEX    -> CCMap[Cost Center]
// ---------------------------------------------------------------------
PL Level 3 =
VAR _Section = TBData[PL Level 1]
VAR _CogsParent =
    LOOKUPVALUE (
        COGSMap[CTDesc Parent],
        COGSMap[Cc],                    // *** KEY *** in COGSMap -- see note A
        TBData[Cc]
    )
VAR _CostCenter =
    LOOKUPVALUE (
        CCMap[Cost Center],
        CCMap[Cost Center],
        TBData[Cc]
    )
RETURN
    SWITCH (
        TRUE (),
        _Section = "Revenue", TBData[PL Label],
        _Section = "COGS",    _CogsParent,
        _Section = "OPEX",    _CostCenter,
        BLANK ()
    )

// NOTE A: if COGSMap is keyed on the account (or on CTDesc) rather than on
// the cost center, change the last two arguments accordingly, e.g.
//     LOOKUPVALUE ( COGSMap[CTDesc Parent], COGSMap[Account], TBData[Account] )
//
// NOTE B: if CCMap[Cost Center] IS the key column (identical to TBData[Cc]),
// the lookup is redundant -- just use TBData[Cc] for the OPEX branch. Use the
// lookup only when CCMap[Cost Center] is a *descriptive* label.


// ---------------------------------------------------------------------
// 4. LEVEL 4  -- the green detail column (OPTIONAL / NOT YET SPECIFIED)
//    Sketch shows: FTR Internet / Vantage Internet / Residential / Business
//                  for Revenue, and Salaries & Wages / Payroll Taxes for OPEX.
//    Most likely this is the account description off the trial balance.
//    Point it at whatever column actually holds that text.
// ---------------------------------------------------------------------
PL Level 4 =
VAR _Section = TBData[PL Level 1]
RETURN
    SWITCH (
        TRUE (),
        _Section = "Revenue", TBData[Account Description],   // *** CONFIRM ***
        _Section = "COGS",    BLANK (),                      // sketch stops at L3
        _Section = "OPEX",    TBData[Account Description],   // *** CONFIRM ***
        BLANK ()
    )


// ---------------------------------------------------------------------
// 5. SORT COLUMNS -- so the matrix renders Revenue, COGS, OPEX in order
//    Set each PL Level n column's "Sort by column" to its matching Sort col.
// ---------------------------------------------------------------------
PL Level 1 Sort =
SWITCH (
    TBData[PL Level 1],
    "Revenue", 10,
    "COGS",    30,
    "OPEX",    50,
    99
)

// Level 2 sort: Revenue groups first, then OPEX departments in reporting
// order (direct operations -> commercial -> support -> overhead). Reorder the
// numbers to taste; anything unlisted falls to 99 and sorts last.
PL Level 2 Sort =
VAR _L1 = TBData[PL Level 1 Sort]
VAR _L2 =
    SWITCH (
        TBData[PL Level 2],
        // Revenue
        "Total Residential Revenue",  1,
        "Total SMB Revenue",          2,
        // OPEX departments
        "Direct Field Operations",    1,
        "Construction",               2,
        "Logistics",                  3,
        "Consumer Sales",             4,
        "Commercial Sales",           5,
        "Corporate Marketing",        6,
        "BI/Product",                 7,
        "Technology",                 8,
        "Direct Legal & Regulatory",  9,
        "Headquarters Expenses",     10,
        "G&A",                       11,
        // Matrix 286 rows, pulled out of their departments
        "Bonus",                     12,
        99
    )
RETURN
    _L1 * 100 + _L2


// =====================================================================
// MEASURES
// =====================================================================
// SIGN CONVENTION: this assumes costs are stored as POSITIVE numbers in
// TBData[Amount]. If your trial balance carries costs as NEGATIVES (credit
// convention), every subtraction below becomes an addition:
//     Adjusted EBITDA := [Total Revenue] + [Total COGS] + [Total OPEX]
// Check one COGS row in Data view before trusting these numbers.
// ---------------------------------------------------------------------

Amount := SUM ( TBData[Amount] )

Total Revenue :=
CALCULATE ( [Amount], TBData[PL Level 1] = "Revenue" )

Total COGS :=
CALCULATE ( [Amount], TBData[PL Level 1] = "COGS" )

Gross Profit :=
[Total Revenue] - [Total COGS]

Total OPEX :=
CALCULATE ( [Amount], TBData[PL Level 1] = "OPEX" )

Adjusted EBITDA :=
[Total Revenue] - [Total COGS] - [Total OPEX]

Gross Margin % :=
DIVIDE ( [Gross Profit], [Total Revenue] )

Adjusted EBITDA Margin % :=
DIVIDE ( [Adjusted EBITDA], [Total Revenue] )

// D&A CAVEAT: EBITDA excludes Depreciation and Amortisation. The formula
// above is Revenue - COGS - OPEX exactly as specified, so if any D&A accounts
// sit inside the 12 OPEX departments, this is operating income, not EBITDA.
// To exclude them, filter the accounts out of Total OPEX, e.g.
//     Total OPEX :=
//     CALCULATE (
//         [Amount],
//         TBData[PL Level 1] = "OPEX",
//         NOT TBData[Account] IN { <D&A account codes> }
//     )
// Confirm with Finance which accounts are in scope before changing this.


// =====================================================================
// ADJUSTED EBITDA AS A ROW IN THE MATRIX
// =====================================================================
// IMPORTANT -- why this is NOT another value in the PL Level 1 column:
//
// PL Level 1 is a CALCULATED COLUMN. Every value it produces is a label
// stamped onto an actual trial-balance row. Adjusted EBITDA is not a set of
// rows -- it is arithmetic ACROSS three sets of rows. No TB row "is" Adjusted
// EBITDA, so there is nothing for the column to label. Adding
// "Adjusted EBITDA" to the SWITCH in PL Level 1 is not possible: it would
// have to steal rows from Revenue, COGS or OPEX, and those rows are already
// counted once in their own section. The same is true of Total Revenue and
// Gross Profit.
//
// Calculated rows must therefore come from a disconnected LAYOUT table that
// supplies the row headers, with a measure deciding what each row evaluates.
// Pick ONE of the two approaches below.


// ---------------------------------------------------------------------
// APPROACH A (recommended to start) -- two visuals
// ---------------------------------------------------------------------
// Keep the plain hierarchy matrix (PL Level 1 > 2 > 3, subtotals on) and put
// [Gross Profit] and [Adjusted EBITDA] in Card visuals or a small one-row
// matrix directly beneath it. Nothing further to build -- the measures above
// are all you need. This is what most production P&L reports ship, and it is
// always arithmetically correct.


// ---------------------------------------------------------------------
// APPROACH B -- one matrix with Adjusted EBITDA as a real row
// ---------------------------------------------------------------------
// Gives the exact sketch layout. The row headers come from PL Layout instead
// of from PL Level 1.

PL Layout =
DATATABLE (
    "Sort",     INTEGER,
    "PL Line",  STRING,
    "Row Type", STRING,
    {
        { 10, "Revenue",         "Section" },
        { 20, "Total Revenue",   "Calc"    },
        { 30, "COGS",            "Section" },
        { 40, "Gross Profit",    "Calc"    },
        { 50, "OPEX",            "Section" },
        { 60, "Adjusted EBITDA", "Calc"    }
    }
)

// Setup:
//   1. Leave PL Layout DISCONNECTED -- no relationship to anything.
//   2. Sort PL Line by Sort (select PL Line -> Column tools -> Sort by column).
//   3. Matrix Rows: 'PL Layout'[PL Line], then TBData[PL Level 2],
//      then TBData[PL Level 3].
//   4. Matrix Values: [PL Value] (below), NOT [Amount].
//   5. Format pane -> turn "Show items with no data" OFF, so the Calc rows
//      do not sprout empty children.

PL Value :=
VAR _Line = SELECTEDVALUE ( 'PL Layout'[PL Line] )
VAR _Type = SELECTEDVALUE ( 'PL Layout'[Row Type] )
VAR _IsDrilled = ISINSCOPE ( TBData[PL Level 2] )
RETURN
    IF (
        // a Calc row has no detail to break down -- blank it when drilled
        _Type = "Calc" && _IsDrilled,
        BLANK (),
        SWITCH (
            _Line,
            "Revenue",         CALCULATE ( [Amount], TBData[PL Level 1] = "Revenue" ),
            "COGS",            CALCULATE ( [Amount], TBData[PL Level 1] = "COGS" ),
            "OPEX",            CALCULATE ( [Amount], TBData[PL Level 1] = "OPEX" ),
            "Total Revenue",   [Total Revenue],
            "Gross Profit",    [Gross Profit],
            "Adjusted EBITDA", [Adjusted EBITDA],
            BLANK ()
        )
    )

// How the filtering works: PL Level 2 and PL Level 3 are columns ON TBData,
// so when the matrix drills into them they filter TBData directly. The
// CALCULATE in each Section branch then narrows that to the right section.
// PL Layout contributes only the row label -- it filters nothing, which is
// exactly why the Calc rows can reach across sections.
//
// Grand total: SELECTEDVALUE returns BLANK when several PL Lines are in
// scope, so the total row falls to the final BLANK(). If you want Adjusted
// EBITDA on the total row instead, replace that last BLANK() with
// [Adjusted EBITDA].
